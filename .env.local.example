# Supabase — get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# NewsAPI — free tier at newsapi.org (optional, falls back to mock data)
NEWSAPI_KEY=

# Secret to protect the /api/analyze endpoint
ANALYZE_SECRET=change-me-to-something-random

# Base URL used by server components to call internal API routes
NEXT_PUBLIC_BASE_URL=http://localhost:3000
